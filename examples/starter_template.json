{
  "meta": {
    "model_name": "Template-Model",
    "car_name": "Starter Prototype",
    "slogan": "Minimal syntax reference build.",
    "design_concept": "Minimal baseline configuration demonstrating 4-wheel differential motor formulas, 360-deg turret rotation ('cannon_yaw_deg'), 'let' helper bindings, and basic cliff/cannon rules.",
    "primary_color": "#475569",
    "secondary_color": "#94A3B8",
    "accent_color": "#38BDF8",
    "chassis_finish": "matte"
  },
  "chassis": {
    "size": [0.52, 0.38, 0.16],
    "density": 240
  },
  "parts": [
    {"id": "fl_wheel", "type": "wheel", "mount": "front_left", "params": {"radius": 0.18, "width": 0.06, "gear": "balanced"}},
    {"id": "fr_wheel", "type": "wheel", "mount": "front_right", "params": {"radius": 0.18, "width": 0.06, "gear": "balanced"}},
    {"id": "bl_wheel", "type": "wheel", "mount": "back_left", "params": {"radius": 0.18, "width": 0.06, "gear": "balanced"}},
    {"id": "br_wheel", "type": "wheel", "mount": "back_right", "params": {"radius": 0.18, "width": 0.06, "gear": "balanced"}},
    {"id": "front_wedge", "type": "wedge", "mount": "front", "params": {"width": 0.44, "length": 0.26, "slope_deg": 25.0}},
    {"id": "top_cannon", "type": "energy_cannon", "mount": "top", "params": {"mode": "standard", "pitch_deg": 0.0}},
    {"id": "belly_weight", "type": "gyro_stabilizer", "mount": "bottom", "params": {"radius": 0.15, "thickness": 0.045}}
  ],
  "decorations": [
    {
      "shape": "box",
      "parent": "chassis",
      "pos": [-0.16, 0.0, 0.11],
      "size": [0.12, 0.24, 0.04],
      "color": "#94A3B8",
      "material": "matte"
    }
  ],
  "strategy": {
    "vars": {
      "unstick_sign": 1.0
    },
    "let": {
      "turn_enemy": "clamp(enemy_angle_deg / 65.0, -1.0, 1.0)",
      "turn_center": "clamp(center_angle_deg / 55.0, -1.0, 1.0)"
    },
    "rules": [
      {
        "name": "cliff_stop_and_turn_inward",
        "when": "edge_dist < 0.85 and abs_edge_angle_deg < 75",
        "action": {
          "left": "clamp(0.85 - turn_center, -1.0, 1.0)",
          "right": "clamp(0.85 + turn_center, -1.0, 1.0)",
          "cannon_yaw_deg": "enemy_angle_deg",
          "cannon": false
        }
      },
      {
        "name": "basic_unstick",
        "when": "stalled_sec > 1.2",
        "set_vars": {
          "unstick_sign": "sign(sin(time_sec * 6.0))"
        },
        "action": {
          "left": "clamp(-0.80 + 0.40 * unstick_sign, -1.0, 1.0)",
          "right": "clamp(-0.80 - 0.40 * unstick_sign, -1.0, 1.0)",
          "cannon_yaw_deg": "enemy_angle_deg",
          "cannon": "cannon_ready and abs_cannon_enemy_angle_deg < 12"
        }
      }
    ],
    "default_action": {
      "left": "clamp(0.82 * max(0.15, cos_deg(enemy_angle_deg)) - turn_enemy, -1.0, 1.0)",
      "right": "clamp(0.82 * max(0.15, cos_deg(enemy_angle_deg)) + turn_enemy, -1.0, 1.0)",
      "cannon_yaw_deg": "enemy_angle_deg",
      "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 10"
    }
  }
}
