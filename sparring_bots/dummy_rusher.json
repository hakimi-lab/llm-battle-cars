{
  "meta": {
    "model_name": "Sparring-Bot",
    "car_name": "Dummy Rusher",
    "slogan": "天下武功，唯快与低铲不破！",
    "design_concept": "Agile low-slung 4WD wedge rammer (~21kg) with speed-geared wheels, compact belly keel, and rear booster.",
    "primary_color": "#2563EB",
    "secondary_color": "#F59E0B",
    "accent_color": "#38BDF8",
    "chassis_finish": "glossy"
  },
  "chassis": {
    "size": [0.50, 0.38, 0.14],
    "density": 225
  },
  "parts": [
    {"id": "fl_w", "type": "wheel", "mount": "front_left", "params": {"radius": 0.16, "width": 0.055, "gear": "speed"}},
    {"id": "fr_w", "type": "wheel", "mount": "front_right", "params": {"radius": 0.16, "width": 0.055, "gear": "speed"}},
    {"id": "bl_w", "type": "wheel", "mount": "back_left", "params": {"radius": 0.16, "width": 0.055, "gear": "speed"}},
    {"id": "br_w", "type": "wheel", "mount": "back_right", "params": {"radius": 0.16, "width": 0.055, "gear": "speed"}},
    {"id": "front_plow", "type": "wedge", "mount": "front", "color": "#F59E0B", "params": {"width": 0.48, "length": 0.28, "slope_deg": 23}},
    {"id": "rear_boost", "type": "thruster", "mount": "back", "color": "#FF6B00", "params": {"aim": "push_forward", "power": 0.92}},
    {"id": "belly_keel", "type": "gyro_stabilizer", "mount": "bottom", "params": {"radius": 0.14, "thickness": 0.045}}
  ],
  "decorations": [],
  "strategy": {
    "let": {
      "turn_c": "clamp(center_angle_deg / 50.0, -1.0, 1.0)",
      "flank_ang": "wrap_deg(enemy_angle_deg + (32.0 if enemy_dist > 1.25 else 0.0))",
      "turn_f": "clamp(flank_ang / 58.0, -1.0, 1.0)"
    },
    "rules": [
      {
        "name": "cliff_brake",
        "when": "edge_dist < 0.95 and abs_edge_angle_deg < 80",
        "action": {
          "left": "clamp(0.92 * max(0.15, cos_deg(center_angle_deg)) - turn_c, -1.0, 1.0)",
          "right": "clamp(0.92 * max(0.15, cos_deg(center_angle_deg)) + turn_c, -1.0, 1.0)"
        }
      },
      {
        "name": "unstick_stall",
        "when": "stalled_sec > 1.1",
        "action": {
          "left": "-0.85 + 0.45 * sign(sin(time_sec * 6.0))",
          "right": "-0.85 - 0.45 * sign(sin(time_sec * 6.0))"
        }
      },
      {
        "name": "nitro_ram_lineup",
        "when": "enemy_dist < 1.55 and abs_enemy_angle_deg < 16 and edge_dist > 1.35",
        "action": {
          "left": "clamp(1.0 - enemy_angle_deg / 55.0, -1.0, 1.0)",
          "right": "clamp(1.0 + enemy_angle_deg / 55.0, -1.0, 1.0)",
          "thruster": true
        }
      }
    ],
    "default_action": {
      "left": "clamp(0.88 * max(0.20, cos_deg(flank_ang)) - turn_f, -1.0, 1.0)",
      "right": "clamp(0.88 * max(0.20, cos_deg(flank_ang)) + turn_f, -1.0, 1.0)"
    }
  }
}
