{
  "meta": {
    "model_name": "BuiltIn-Sparring",
    "car_name": "Dummy Ranger",
    "slogan": "侧向环绕走位 + 360°旋转炮塔预判射击！",
    "design_concept": "Lightweight high-speed ranged sparring bot (~21kg) with speed-geared wheels and twin 360-deg rotatable plasma cannon turrets.",
    "primary_color": "#0284C7",
    "secondary_color": "#38BDF8",
    "accent_color": "#22D3EE",
    "chassis_finish": "metallic"
  },
  "chassis": {
    "size": [0.50, 0.38, 0.14],
    "density": 215
  },
  "parts": [
    {"id": "fl", "type": "wheel", "mount": "front_left", "params": {"radius": 0.17, "width": 0.055, "gear": "speed"}},
    {"id": "fr", "type": "wheel", "mount": "front_right", "params": {"radius": 0.17, "width": 0.055, "gear": "speed"}},
    {"id": "bl", "type": "wheel", "mount": "back_left", "params": {"radius": 0.17, "width": 0.055, "gear": "speed"}},
    {"id": "br", "type": "wheel", "mount": "back_right", "params": {"radius": 0.17, "width": 0.055, "gear": "speed"}},
    {"id": "cannon_main", "type": "energy_cannon", "mount": "top_front", "params": {"mode": "heavy", "pitch_deg": 0.0}},
    {"id": "cannon_sub", "type": "energy_cannon", "mount": "top_back", "params": {"mode": "rapid", "pitch_deg": 0.0}},
    {"id": "keel", "type": "gyro_stabilizer", "mount": "bottom", "params": {"radius": 0.13, "thickness": 0.04}}
  ],
  "decorations": [],
  "strategy": {
    "let": {
      "turn_c": "clamp(center_angle_deg / 50.0, -1.0, 1.0)",
      "orbit_ang": "wrap_deg(enemy_angle_deg + 78.0 - clamp((enemy_dist - 1.95) * 32.0, -48.0, 48.0))",
      "turn_orb": "clamp(orbit_ang / 55.0, -1.0, 1.0)",
      "lead_t": "enemy_dist / 14.5",
      "lead_dx": "(enemy_x + enemy_vx * lead_t) - self_x",
      "lead_dy": "(enemy_y + enemy_vy * lead_t) - self_y",
      "turret_aim": "wrap_deg(atan2_deg(lead_dy, lead_dx) - self_yaw_deg)"
    },
    "rules": [
      {
        "name": "edge_escape",
        "when": "edge_dist < 1.15 and abs_edge_angle_deg < 110",
        "action": {
          "left": "clamp(0.92 * max(0.2, cos_deg(center_angle_deg)) - turn_c, -1.0, 1.0)",
          "right": "clamp(0.92 * max(0.2, cos_deg(center_angle_deg)) + turn_c, -1.0, 1.0)",
          "cannon_yaw_deg": "turret_aim",
          "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 10"
        }
      },
      {
        "name": "avoid_spring_catapult",
        "when": "spring_ready and spring_dist < 0.95 and abs_spring_angle_deg < 85",
        "action": {
          "left": "clamp(0.80 - turn_c, -1.0, 1.0)",
          "right": "clamp(0.80 + turn_c, -1.0, 1.0)",
          "cannon_yaw_deg": "turret_aim",
          "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 9"
        }
      },
      {
        "name": "skirt_mud_bog",
        "when": "mud_dist < 0.45 and abs_mud_angle_deg < 75",
        "action": {
          "left": "clamp(0.85 - clamp(wrap_deg(mud_angle_deg + iff(mud_angle_deg >= 0, -88.0, 88.0)) / 50.0, -1.0, 1.0), -1.0, 1.0)",
          "right": "clamp(0.85 + clamp(wrap_deg(mud_angle_deg + iff(mud_angle_deg >= 0, -88.0, 88.0)) / 50.0, -1.0, 1.0), -1.0, 1.0)",
          "cannon_yaw_deg": "turret_aim",
          "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 10"
        }
      },
      {
        "name": "recover_from_mirror_ice",
        "when": "on_ice",
        "action": {
          "left": "clamp(0.75 * max(0.25, cos_deg(center_angle_deg)) - 0.75 * turn_c, -1.0, 1.0)",
          "right": "clamp(0.75 * max(0.25, cos_deg(center_angle_deg)) + 0.75 * turn_c, -1.0, 1.0)",
          "cannon_yaw_deg": "turret_aim",
          "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 10"
        }
      },
      {
        "name": "unstick",
        "when": "stalled_sec > 1.0",
        "action": {
          "left": "-0.85 + 0.40 * sign(sin(time_sec * 6.0))",
          "right": "-0.85 - 0.40 * sign(sin(time_sec * 6.0))",
          "cannon_yaw_deg": "turret_aim",
          "cannon": "cannon_ready and abs_cannon_enemy_angle_deg < 12"
        }
      }
    ],
    "default_action": {
      "left": "clamp(0.86 * max(0.28, cos_deg(orbit_ang)) - turn_orb, -1.0, 1.0)",
      "right": "clamp(0.86 * max(0.28, cos_deg(orbit_ang)) + turn_orb, -1.0, 1.0)",
      "cannon_yaw_deg": "turret_aim",
      "cannon": "cannon_ready and has_line_of_sight and abs_cannon_enemy_angle_deg < 9"
    }
  }
}
